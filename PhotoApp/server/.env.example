# Chave da API do Claude (https://console.anthropic.com). Também funciona com `ant auth login`.
ANTHROPIC_API_KEY=
# Modelo usado para análise e busca
ANTHROPIC_MODEL=claude-opus-5-5
# Client ID OAuth do Google (tipo "Aplicativo da Web"). Deixe vazio para modo de desenvolvimento sem login.
GOOGLE_CLIENT_ID=
PORT=8787
